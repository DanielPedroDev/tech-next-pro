<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Produtos e Acessórios de Tecnologia | Tech Next Pro</title>
    <meta name="description" content="Confira produtos e acessórios de tecnologia da Tech Next Pro, como cabos HDMI, carregadores, cabos e adaptadores em Carpina - PE.">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Tech Next Pro">
    <meta name="theme-color" content="#03070d">

    <link rel="canonical" href="https://technextpro.com.br/produtos">
    <link rel="icon" type="image/png" href="/images/logo-header.png">
    <link rel="apple-touch-icon" href="/images/logo-header.png">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="Tech Next Pro">
    <meta property="og:title" content="Produtos e Acessórios de Tecnologia | Tech Next Pro">
    <meta property="og:description" content="Confira produtos e acessórios de tecnologia da Tech Next Pro, como cabos HDMI, carregadores, cabos e adaptadores em Carpina - PE.">
    <meta property="og:url" content="https://technextpro.com.br/produtos">
    <meta property="og:image" content="https://technextpro.com.br/images/logo-header.png">
    <meta property="og:image:alt" content="Tech Next Pro">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Produtos e Acessórios de Tecnologia | Tech Next Pro">
    <meta name="twitter:description" content="Confira produtos e acessórios de tecnologia da Tech Next Pro, como cabos HDMI, carregadores, cabos e adaptadores em Carpina - PE.">
    <meta name="twitter:image" content="https://technextpro.com.br/images/logo-header.png">

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">


</head>

<body>

<header class="header">

    <div class="container header-content">

        <a href="/" class="logo-link">
            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
                class="logo"
            >
        </a>

        <nav class="nav">

            <a href="/">Início</a>

            <a href="/servicos">
                Serviços
            </a>

            <a href="/produtos" class="active">
                Produtos
            </a>

            <a href="/sites">
                Criação de Sites
            </a>

            <a href="/portfolio">
                Portfólio
            </a>

            <a href="/sobre">
                Sobre
            </a>

            <a href="/contato" class="nav-contact">
                Contato
            </a>

        </nav>

        <button class="menu-button" aria-label="Abrir menu">
            ☰
        </button>

    </div>

</header>


<main>

    <!-- HERO -->

    <section class="page-hero products-page-hero">

        <div class="page-hero-grid"></div>

        <div class="container page-hero-content">

            <span class="hero-badge">
                <span class="status-dot"></span>
                PRODUTOS E ACESSÓRIOS
            </span>

            <h1>
                Tecnologia para
                <span>conectar você.</span>
            </h1>

            <p>
                Conheça alguns dos produtos e acessórios de tecnologia
                disponibilizados pela Tech Next Pro para uso pessoal,
                profissional e empresarial.
            </p>

        </div>

    </section>


    <!-- INTRODUÇÃO -->

    <section class="products-intro">

        <div class="container">

            <div class="products-intro-content">

                <div>

                    <span class="section-label">
                        NOSSA VITRINE
                    </span>

                    <h2>
                        Produtos selecionados
                        <span>para suas necessidades.</span>
                    </h2>

                </div>

                <p>
                    Trabalhamos com diferentes categorias de produtos
                    e acessórios tecnológicos. A disponibilidade pode
                    variar conforme o estoque.
                </p>

            </div>

        </div>

    </section>


    <!-- CATEGORIAS -->

    <section class="section product-catalog-section">

        <div class="container">

            <div class="product-catalog-grid">


                <!-- HDMI -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration hdmi-illustration">
                            HDMI
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            CONECTIVIDADE
                        </span>

                        <h3>
                            Cabos HDMI
                        </h3>

                        <p>
                            Cabos para conexão de computadores,
                            notebooks, televisores, projetores e
                            outros dispositivos compatíveis.
                        </p>

                        <div class="product-tags">
                            <span>HDMI</span>
                            <span>Vídeo</span>
                            <span>Áudio</span>
                        </div>

                    </div>

                </article>


                <!-- CARREGADORES -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration charger-illustration">
                            ⚡
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            ENERGIA
                        </span>

                        <h3>
                            Carregadores
                        </h3>

                        <p>
                            Carregadores e soluções para alimentação
                            de diferentes dispositivos eletrônicos.
                        </p>

                        <div class="product-tags">
                            <span>USB</span>
                            <span>Energia</span>
                            <span>Carregamento</span>
                        </div>

                    </div>

                </article>


                <!-- CABOS -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration cable-illustration">
                            USB
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            ACESSÓRIOS
                        </span>

                        <h3>
                            Cabos e Conectores
                        </h3>

                        <p>
                            Cabos, conectores e acessórios para
                            computadores, celulares e outros
                            equipamentos.
                        </p>

                        <div class="product-tags">
                            <span>USB</span>
                            <span>Conectores</span>
                            <span>Cabos</span>
                        </div>

                    </div>

                </article>


                <!-- ADAPTADORES -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration adapter-illustration">
                            ⇄
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            CONECTIVIDADE
                        </span>

                        <h3>
                            Adaptadores
                        </h3>

                        <p>
                            Adaptadores para conectar diferentes
                            padrões e equipamentos tecnológicos.
                        </p>

                        <div class="product-tags">
                            <span>Adaptadores</span>
                            <span>Conexão</span>
                            <span>Tech</span>
                        </div>

                    </div>

                </article>


                <!-- PERIFÉRICOS -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration peripheral-illustration">
                            ◉
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            PERIFÉRICOS
                        </span>

                        <h3>
                            Periféricos
                        </h3>

                        <p>
                            Acessórios para complementar computadores
                            e melhorar sua experiência de uso.
                        </p>

                        <div class="product-tags">
                            <span>PC</span>
                            <span>Periféricos</span>
                            <span>Acessórios</span>
                        </div>

                    </div>

                </article>


                <!-- OUTROS -->

                <article class="product-showcase-card">

                    <div class="product-visual">

                        <div class="product-visual-glow"></div>

                        <div class="product-illustration other-illustration">
                            +
                        </div>

                    </div>

                    <div class="product-showcase-content">

                        <span class="product-category">
                            TECNOLOGIA
                        </span>

                        <h3>
                            Outros acessórios
                        </h3>

                        <p>
                            Consulte também outros produtos e
                            acessórios disponíveis na Tech Next Pro.
                        </p>

                        <div class="product-tags">
                            <span>Tech</span>
                            <span>Acessórios</span>
                            <span>Produtos</span>
                        </div>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- OBSERVAÇÃO -->

    <section class="product-note-section">

        <div class="container">

            <div class="product-note">

                <div class="product-note-icon">
                    i
                </div>

                <div>

                    <h3>
                        Quer saber sobre disponibilidade?
                    </h3>

                    <p>
                        A variedade e disponibilidade dos produtos
                        podem mudar. Entre em contato com a Tech Next Pro
                        para consultar os produtos disponíveis.
                    </p>

                </div>

                <a href="/contato" class="btn btn-primary">
                    Entrar em contato
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta-section">

        <div class="container">

            <div class="cta-box">

                <div>

                    <span class="section-label">
                        TECNOLOGIA E SOLUÇÕES
                    </span>

                    <h2>
                        Muito mais que produtos.
                    </h2>

                    <p>
                        Também criamos sites, desenvolvemos sistemas
                        e oferecemos serviços de manutenção.
                    </p>

                </div>

                <a href="/servicos" class="btn btn-primary">
                    Conhecer serviços
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

</main>


<footer class="footer">

    <div class="container footer-content">

        <div class="footer-brand">

            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
            >

            <p>
                Soluções em tecnologia para pessoas,
                empresas e projetos.
            </p>

        </div>


        <div class="footer-links">

            <h3>Navegação</h3>

            <a href="/">Início</a>
            <a href="/servicos">Serviços</a>
            <a href="/produtos">Produtos</a>
            <a href="/sites">Criação de Sites</a>
            <a href="/portfolio">Portfólio</a>

        </div>


        <div class="footer-links">

            <h3>Contato</h3>

            <a href="/contato">
                Fale conosco
            </a>

            <a
                href="https://www.instagram.com/tech.nextpro/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Instagram
            </a>

        </div>

    </div>


    <div class="footer-bottom">

        <div class="container">

            <p>
                © <%= new Date().getFullYear() %>
                Tech Next Pro. Todos os direitos reservados.
            </p>

        </div>

    </div>

</footer>


<script src="/script.js"></script>

</body>
</html>
