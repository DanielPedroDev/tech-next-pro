<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %></title>

    <meta
        name="description"
        content="Conheça os serviços da Tech Next Pro: criação de sites, desenvolvimento de sistemas, manutenção de computadores e soluções em tecnologia."
    >

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >
</head>

<body>

<header class="header">

    <div class="container header-content">

        <a href="/" class="logo-link">
            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
                class="logo"
            >
        </a>

        <nav class="nav">

            <a href="/">Início</a>

            <a href="/servicos" class="active">
                Serviços
            </a>

            <a href="/produtos">
                Produtos
            </a>

            <a href="/sites">
                Criação de Sites
            </a>

            <a href="/portfolio">
                Portfólio
            </a>

            <a href="/sobre">
                Sobre
            </a>

            <a href="/contato" class="nav-contact">
                Contato
            </a>

        </nav>

        <button class="menu-button" aria-label="Abrir menu">
            ☰
        </button>

    </div>

</header>


<main>

    <!-- HERO DA PÁGINA -->

    <section class="page-hero">

        <div class="page-hero-grid"></div>

        <div class="container page-hero-content">

            <span class="hero-badge">
                <span class="status-dot"></span>
                NOSSOS SERVIÇOS
            </span>

            <h1>
                Soluções para
                <span>cada necessidade.</span>
            </h1>

            <p>
                Da manutenção do seu computador ao desenvolvimento
                de sites e sistemas personalizados, a Tech Next Pro
                trabalha para transformar tecnologia em solução.
            </p>

        </div>

    </section>


    <!-- SERVIÇOS -->

    <section class="section service-list-section">

        <div class="container">

            <div class="section-heading">

                <span class="section-label">
                    O QUE PODEMOS FAZER
                </span>

                <h2>
                    Tecnologia que
                    <span>resolve.</span>
                </h2>

                <p>
                    Conheça nossas principais áreas de atuação.
                </p>

            </div>


            <div class="service-list">


                <!-- SITE -->

                <article class="service-detail">

                    <div class="service-detail-number">
                        01
                    </div>

                    <div class="service-detail-icon">
                        &lt;/&gt;
                    </div>

                    <div class="service-detail-content">

                        <span class="service-detail-category">
                            DESENVOLVIMENTO WEB
                        </span>

                        <h3>
                            Criação de Sites
                        </h3>

                        <p>
                            Criamos sites personalizados para empresas,
                            lojas, profissionais, projetos e negócios
                            que desejam construir uma presença digital
                            profissional.
                        </p>

                        <ul>
                            <li>Sites institucionais</li>
                            <li>Sites para empresas</li>
                            <li>Landing pages</li>
                            <li>Portfólios profissionais</li>
                            <li>Sites responsivos</li>
                            <li>Projetos personalizados</li>
                        </ul>

                        <a href="/sites" class="service-detail-link">
                            Conheça nosso desenvolvimento web →
                        </a>

                    </div>

                </article>


                <!-- SISTEMAS -->

                <article class="service-detail">

                    <div class="service-detail-number">
                        02
                    </div>

                    <div class="service-detail-icon">
                        ⚙
                    </div>

                    <div class="service-detail-content">

                        <span class="service-detail-category">
                            SOFTWARE
                        </span>

                        <h3>
                            Desenvolvimento de Sistemas
                        </h3>

                        <p>
                            Desenvolvemos sistemas personalizados para
                            organizar informações, automatizar tarefas
                            e facilitar processos.
                        </p>

                        <ul>
                            <li>Sistemas empresariais</li>
                            <li>Sistemas de cadastro</li>
                            <li>Controle de informações</li>
                            <li>Painéis administrativos</li>
                            <li>Sistemas com banco de dados</li>
                            <li>Soluções personalizadas</li>
                        </ul>

                        <a href="/contato" class="service-detail-link">
                            Fale sobre seu projeto →
                        </a>

                    </div>

                </article>


                <!-- MANUTENÇÃO -->

                <article class="service-detail">

                    <div class="service-detail-number">
                        03
                    </div>

                    <div class="service-detail-icon">
                        🔧
                    </div>

                    <div class="service-detail-content">

                        <span class="service-detail-category">
                            SUPORTE TÉCNICO
                        </span>

                        <h3>
                            Manutenção de Computadores
                        </h3>

                        <p>
                            Seu computador está lento, apresentando
                            erros ou precisa de uma manutenção?
                            Podemos ajudar.
                        </p>

                        <ul>
                            <li>Formatação</li>
                            <li>Instalação de sistemas</li>
                            <li>Limpeza interna</li>
                            <li>Manutenção preventiva</li>
                            <li>Diagnóstico de problemas</li>
                            <li>Otimização do computador</li>
                        </ul>

                        <a href="/contato" class="service-detail-link">
                            Solicitar atendimento →
                        </a>

                    </div>

                </article>


                <!-- CONFIGURAÇÃO -->

                <article class="service-detail">

                    <div class="service-detail-number">
                        04
                    </div>

                    <div class="service-detail-icon">
                        ⚡
                    </div>

                    <div class="service-detail-content">

                        <span class="service-detail-category">
                            TECNOLOGIA
                        </span>

                        <h3>
                            Configuração e Suporte
                        </h3>

                        <p>
                            Auxiliamos na configuração de equipamentos,
                            periféricos, sistemas e outros recursos
                            tecnológicos.
                        </p>

                        <ul>
                            <li>Configuração de computadores</li>
                            <li>Instalação de programas</li>
                            <li>Configuração de periféricos</li>
                            <li>Configuração de dispositivos</li>
                            <li>Orientação técnica</li>
                        </ul>

                        <a href="/contato" class="service-detail-link">
                            Entre em contato →
                        </a>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta-section">

        <div class="container">

            <div class="cta-box">

                <div>

                    <span class="section-label">
                        PRECISA DE UMA SOLUÇÃO?
                    </span>

                    <h2>
                        Vamos transformar sua ideia em realidade.
                    </h2>

                    <p>
                        Conte para a Tech Next Pro o que você precisa
                        e vamos conversar sobre a melhor solução.
                    </p>

                </div>

                <a href="/contato" class="btn btn-primary">
                    Fale conosco
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

</main>


<footer class="footer">

    <div class="container footer-content">

        <div class="footer-brand">

            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
            >

            <p>
                Soluções em tecnologia para pessoas,
                empresas e projetos.
            </p>

        </div>


        <div class="footer-links">

            <h3>Navegação</h3>

            <a href="/">Início</a>
            <a href="/servicos">Serviços</a>
            <a href="/produtos">Produtos</a>
            <a href="/sites">Criação de Sites</a>
            <a href="/portfolio">Portfólio</a>

        </div>


        <div class="footer-links">

            <h3>Contato</h3>

            <a href="/contato">
                Fale conosco
            </a>

            <a
                href="https://www.instagram.com/tech.nextpro/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Instagram
            </a>

        </div>

    </div>


    <div class="footer-bottom">

        <div class="container">

            <p>
                © <%= new Date().getFullYear() %>
                Tech Next Pro. Todos os direitos reservados.
            </p>

        </div>

    </div>

</footer>


<script src="/script.js"></script>

</body>
</html>
