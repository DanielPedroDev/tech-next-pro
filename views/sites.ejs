<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %></title>

    <meta
        name="description"
        content="Criação de sites personalizados para empresas, lojas, profissionais e projetos. Desenvolvemos sites modernos, responsivos e profissionais."
    >

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >
</head>

<body>

<header class="header">

    <div class="container header-content">

        <a href="/" class="logo-link">
            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
                class="logo"
            >
        </a>

        <nav class="nav">

            <a href="/">Início</a>

            <a href="/servicos">Serviços</a>

            <a href="/produtos">Produtos</a>

            <a href="/sites" class="active">
                Criação de Sites
            </a>

            <a href="/portfolio">Portfólio</a>

            <a href="/sobre">Sobre</a>

            <a href="/contato" class="nav-contact">
                Contato
            </a>

        </nav>

        <button class="menu-button" aria-label="Abrir menu">
            ☰
        </button>

    </div>

</header>


<main>

    <!-- HERO -->

    <section class="sites-hero">

        <div class="sites-hero-grid"></div>

        <div class="container sites-hero-content">

            <div class="sites-hero-text">

                <span class="hero-badge">
                    <span class="status-dot"></span>
                    DESENVOLVIMENTO WEB
                </span>

                <h1>
                    Sua empresa merece
                    <span>um site profissional.</span>
                </h1>

                <p>
                    Criamos sites personalizados para empresas,
                    lojas, profissionais e projetos que querem
                    fortalecer sua presença na internet.
                </p>

                <div class="hero-actions">

                    <a href="/contato" class="btn btn-primary">
                        Quero criar meu site
                        <span>→</span>
                    </a>

                    <a href="/portfolio" class="btn btn-secondary">
                        Ver portfólio
                    </a>

                </div>

                <div class="sites-hero-features">

                    <div class="hero-feature-card">
                        <span class="hero-feature-icon">✦</span>
                        <strong>100%</strong>
                        <span>Personalizado</span>
                    </div>

                    <div class="hero-feature-card">
                        <span class="hero-feature-icon">▣</span>
                        <strong>100%</strong>
                        <span>Responsivo</span>
                    </div>

                    <div class="hero-feature-card">
                        <span class="hero-feature-icon">↯</span>
                        <strong>Web</strong>
                        <span>Moderno</span>
                    </div>

                </div>

            </div>


            <!-- MOCKUP -->

            <div class="website-mockup">

                <div class="mockup-glow"></div>

                <div class="browser-window">

                    <div class="browser-top">

                        <div class="browser-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <div class="browser-address">
                            suaempresa.com.br
                        </div>

                    </div>

                    <div class="mockup-content">

                        <div class="mockup-nav">

                            <div class="mockup-logo">
                                SUA<span>EMPRESA</span>
                            </div>

                            <div class="mockup-links">
                                <span>Início</span>
                                <span>Serviços</span>
                                <span>Sobre</span>
                                <span>Contato</span>
                            </div>

                        </div>

                        <div class="mockup-hero">

                            <div>

                                <small>
                                    SUA EMPRESA ONLINE
                                </small>

                                <h3>
                                    Seu negócio,
                                    <span>mais profissional.</span>
                                </h3>

                                <p>
                                    Um site criado para
                                    apresentar sua empresa.
                                </p>

                                <div class="mockup-button">
                                    Conheça nossa empresa
                                </div>

                            </div>

                        </div>

                        <div class="mockup-cards">

                            <div></div>
                            <div></div>
                            <div></div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- POR QUE TER UM SITE -->

    <section class="section why-site-section">

        <div class="container">

            <div class="section-heading">

                <span class="section-label">
                    PRESENÇA DIGITAL
                </span>

                <h2>
                    Seu negócio não precisa
                    <span>depender apenas das redes sociais.</span>
                </h2>

                <p>
                    Um site profissional ajuda sua empresa a transmitir
                    credibilidade, apresentar seus serviços e ser
                    encontrada por novos clientes.
                </p>

            </div>


            <div class="why-site-grid">

                <article class="why-site-card">

                    <div class="why-site-icon">
                        ✓
                    </div>

                    <h3>
                        Mais credibilidade
                    </h3>

                    <p>
                        Apresente sua empresa de forma profissional
                        e passe mais confiança para seus clientes.
                    </p>

                </article>


                <article class="why-site-card">

                    <div class="why-site-icon">
                        ◉
                    </div>

                    <h3>
                        Sua empresa online
                    </h3>

                    <p>
                        Tenha um espaço próprio na internet para
                        apresentar sua marca, produtos e serviços.
                    </p>

                </article>


                <article class="why-site-card">

                    <div class="why-site-icon">
                        ↗
                    </div>

                    <h3>
                        Mais oportunidades
                    </h3>

                    <p>
                        Facilite o contato de pessoas interessadas
                        em conhecer ou contratar sua empresa.
                    </p>

                </article>


                <article class="why-site-card">

                    <div class="why-site-icon">
                        ⚡
                    </div>

                    <h3>
                        Experiência moderna
                    </h3>

                    <p>
                        Sites adaptados para computadores,
                        tablets e celulares.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- TIPOS DE SITES -->

    <section class="section site-types-section">

        <div class="container">

            <div class="section-heading">

                <span class="section-label">
                    PROJETOS PERSONALIZADOS
                </span>

                <h2>
                    Qual site sua empresa
                    <span>precisa?</span>
                </h2>

            </div>


            <div class="site-types-grid">

                <article class="site-type-card">

                    <span class="site-type-number">
                        01
                    </span>

                    <div class="site-type-icon">
                        ◫
                    </div>

                    <h3>
                        Site Institucional
                    </h3>

                    <p>
                        Ideal para empresas que precisam apresentar
                        sua história, serviços, equipe e formas
                        de contato.
                    </p>

                    <div class="site-type-tags">
                        <span>Empresa</span>
                        <span>Serviços</span>
                        <span>Contato</span>
                    </div>

                </article>


                <article class="site-type-card">

                    <span class="site-type-number">
                        02
                    </span>

                    <div class="site-type-icon">
                        ◈
                    </div>

                    <h3>
                        Site para Loja
                    </h3>

                    <p>
                        Apresente seus produtos e sua marca
                        através de uma vitrine digital profissional.
                    </p>

                    <div class="site-type-tags">
                        <span>Produtos</span>
                        <span>Catálogo</span>
                        <span>Marca</span>
                    </div>

                </article>


                <article class="site-type-card">

                    <span class="site-type-number">
                        03
                    </span>

                    <div class="site-type-icon">
                        ◇
                    </div>

                    <h3>
                        Landing Page
                    </h3>

                    <p>
                        Página criada para divulgar um serviço,
                        produto, campanha ou projeto específico.
                    </p>

                    <div class="site-type-tags">
                        <span>Campanhas</span>
                        <span>Serviços</span>
                        <span>Divulgação</span>
                    </div>

                </article>


                <article class="site-type-card">

                    <span class="site-type-number">
                        04
                    </span>

                    <div class="site-type-icon">
                        &lt;/&gt;
                    </div>

                    <h3>
                        Projeto Personalizado
                    </h3>

                    <p>
                        Uma solução desenvolvida de acordo com
                        as necessidades específicas do seu negócio.
                    </p>

                    <div class="site-type-tags">
                        <span>Personalizado</span>
                        <span>Sistemas</span>
                        <span>Web</span>
                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- O QUE ENTREGAMOS -->

    <section class="section deliver-section">

        <div class="container">

            <div class="section-heading deliver-heading">

                <span class="section-label">ALÉM DO VISUAL</span>

                <h2>
                    Um site pensado para
                    <span>representar sua empresa.</span>
                </h2>

                <p>
                    Cada projeto é planejado para unir identidade visual,
                    tecnologia, velocidade e uma experiência simples para
                    quem visita sua empresa.
                </p>

            </div>

            <div class="deliver-grid">

                <article class="deliver-card">
                    <span class="deliver-card-number">01</span>
                    <div class="deliver-icon">◈</div>
                    <h3>Design profissional</h3>
                    <p>Layout criado de acordo com a identidade da sua marca, sem depender de modelos genéricos.</p>
                </article>

                <article class="deliver-card">
                    <span class="deliver-card-number">02</span>
                    <div class="deliver-icon">⌁</div>
                    <h3>Experiência responsiva</h3>
                    <p>Seu site preparado para funcionar bem em celular, tablet e computador.</p>
                </article>

                <article class="deliver-card">
                    <span class="deliver-card-number">03</span>
                    <div class="deliver-icon">&lt;/&gt;</div>
                    <h3>Desenvolvimento sob medida</h3>
                    <p>Recursos e páginas desenvolvidos conforme as necessidades do seu projeto.</p>
                </article>

                <article class="deliver-card">
                    <span class="deliver-card-number">04</span>
                    <div class="deliver-icon">↗</div>
                    <h3>Publicação e suporte</h3>
                    <p>Orientação para colocar o projeto no ar e continuar evoluindo sua presença digital.</p>
                </article>

            </div>

        </div>

    </section>


    <!-- PROCESSO -->

    <section class="section process-section">

        <div class="container">

            <div class="process-header">

                <div>

                    <span class="section-label">
                        COMO FUNCIONA
                    </span>

                    <h2>
                        Do planejamento
                        <span>ao site no ar.</span>
                    </h2>

                </div>

                <p>
                    Trabalhamos em etapas para transformar sua ideia
                    em uma presença digital profissional.
                </p>

            </div>


            <div class="process-line">

                <article class="process-step">

                    <span>01</span>

                    <h3>
                        Conversa
                    </h3>

                    <p>
                        Entendemos sua empresa, objetivo e necessidades.
                    </p>

                </article>


                <article class="process-step">

                    <span>02</span>

                    <h3>
                        Planejamento
                    </h3>

                    <p>
                        Definimos estrutura, conteúdo e identidade visual.
                    </p>

                </article>


                <article class="process-step">

                    <span>03</span>

                    <h3>
                        Desenvolvimento
                    </h3>

                    <p>
                        Transformamos o projeto em um site funcional.
                    </p>

                </article>


                <article class="process-step">

                    <span>04</span>

                    <h3>
                        Publicação
                    </h3>

                    <p>
                        Colocamos seu projeto online para seus clientes.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- PROJETOS / PORTFÓLIO -->

    <section class="section sites-portfolio-section">

        <div class="container">

            <div class="process-header sites-portfolio-header">

                <div>
                    <span class="section-label">PROJETOS E SISTEMAS</span>
                    <h2>
                        Tecnologia aplicada
                        <span>a projetos reais.</span>
                    </h2>
                </div>

                <p>
                    Além de sites institucionais, também desenvolvemos
                    sistemas e experiências digitais personalizados.
                </p>

            </div>

            <div class="sites-portfolio-grid">

                <a href="/portfolio" class="sites-project-card">
                    <div class="sites-project-top">
                        <span>WEB SYSTEM</span>
                        <span>↗</span>
                    </div>
                    <div class="sites-project-visual project-paroquia">
                        <div class="project-window">
                            <span></span><span></span><span></span>
                            <strong>REGISTROS</strong>
                            <small>Busca inteligente de documentos</small>
                        </div>
                    </div>
                    <div class="sites-project-body">
                        <h3>Sistemas personalizados</h3>
                        <p>Plataformas web desenvolvidas para organizar processos e facilitar o trabalho de empresas e projetos.</p>
                    </div>
                </a>

                <a href="/portfolio" class="sites-project-card">
                    <div class="sites-project-top">
                        <span>BUSINESS WEBSITE</span>
                        <span>↗</span>
                    </div>
                    <div class="sites-project-visual project-business">
                        <div class="project-window">
                            <span></span><span></span><span></span>
                            <strong>SUA MARCA</strong>
                            <small>Presença digital profissional</small>
                        </div>
                    </div>
                    <div class="sites-project-body">
                        <h3>Sites para empresas</h3>
                        <p>Apresentação profissional de serviços, produtos, diferenciais e canais de contato.</p>
                    </div>
                </a>

                <a href="/portfolio" class="sites-project-card">
                    <div class="sites-project-top">
                        <span>CUSTOM PROJECT</span>
                        <span>↗</span>
                    </div>
                    <div class="sites-project-visual project-custom">
                        <div class="project-window">
                            <span></span><span></span><span></span>
                            <strong>SEU PROJETO</strong>
                            <small>Uma solução criada para sua necessidade</small>
                        </div>
                    </div>
                    <div class="sites-project-body">
                        <h3>Projetos sob medida</h3>
                        <p>Ideias transformadas em páginas, sistemas e soluções web com identidade própria.</p>
                    </div>
                </a>

            </div>

            <div class="sites-portfolio-action">
                <a href="/portfolio" class="btn btn-secondary">Ver portfólio completo <span>→</span></a>
            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="sites-cta-section">

        <div class="container">

            <div class="sites-cta">

                <div>

                    <span class="section-label">
                        SEU PROJETO PODE COMEÇAR AGORA
                    </span>

                    <h2>
                        Vamos criar o site
                        da sua empresa?
                    </h2>

                    <p>
                        Conte-nos sobre seu negócio e vamos conversar
                        sobre uma solução personalizada.
                    </p>

                </div>

                <a href="/contato" class="btn btn-primary">
                    Solicitar projeto
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

</main>


<footer class="footer">

    <div class="container footer-content">

        <div class="footer-brand">

            <img
                src="/images/logo-header.png"
                alt="Tech Next Pro"
            >

            <p>
                Soluções em tecnologia para pessoas,
                empresas e projetos.
            </p>

        </div>

        <div class="footer-links">

            <h3>Navegação</h3>

            <a href="/">Início</a>
            <a href="/servicos">Serviços</a>
            <a href="/produtos">Produtos</a>
            <a href="/sites">Criação de Sites</a>
            <a href="/portfolio">Portfólio</a>

        </div>

        <div class="footer-links">

            <h3>Contato</h3>

            <a href="/contato">
                Fale conosco
            </a>

            <a
                href="https://www.instagram.com/tech.nextpro/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Instagram
            </a>

        </div>

    </div>

    <div class="footer-bottom">

        <div class="container">

            <p>
                © <%= new Date().getFullYear() %>
                Tech Next Pro. Todos os direitos reservados.
            </p>

        </div>

    </div>

</footer>


<script src="/script.js"></script>

</body>
</html>
