            </p>

        </div>

        <div class="footer-links">

            <h3>Navegação</h3>

            <a href="/">Início</a>
            <a href="/servicos">Serviços</a>
            <a href="/produtos">Produtos</a>
            <a href="/sites">Criação de Sites</a>
            <a href="/portfolio">Portfólio</a>

        </div>

        <div class="footer-links">

            <h3>Contato</h3>

            <a
                href="https://wa.me/5581999606951?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20Tech%20Next%20Pro."
                target="_blank"
                rel="noopener noreferrer"
            >
                WhatsApp
            </a>

            <a
                href="https://www.instagram.com/tech.nextpro/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Instagram
            </a>

        </div>

    </div>

    <div class="footer-bottom">

        <div class="container">

            <p>
                © <%= new Date().getFullYear() %>
                Tech Next Pro. Todos os direitos reservados.
            </p>

        </div>

    </div>

</footer>

